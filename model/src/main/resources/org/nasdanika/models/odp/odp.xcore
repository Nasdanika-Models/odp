@Ecore(nsURI="https://odp.models.nasdanika.org", nsPrefix="org.nasdanika.models.odp")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.odp

import org.nasdanika.models.presentation.Presentation
import org.nasdanika.models.presentation.Slide
import org.nasdanika.models.presentation.Shape

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

class OdpPresentation extends Presentation {
    contains Style[] styles
}

/* draw:page */
class OdpSlide extends Slide {
    /* draw:style-name */
    String styleName
    /* presentation:presentation-page-layout-name */
    String pageLayoutName
}

/*
 * ODF automatic/common style � flattened name/family + properties map,
 * not the full ODF style model.
 */
class Style {
    String name
    /* graphic | paragraph | text | presentation | drawing-page */
    String family
    String parentStyleName
    contains org.nasdanika.models.nxcore.StringToStringMapEntry[] properties
}

/* Shape with an ODF style reference. */
class OdpShape extends Shape {
    String styleName
    /* presentation:class for placeholder frames: title | outline | subtitle | notes | ... */
    String presentationClass
}

/* Preserved-but-not-modeled elements (charts, OLE, custom draw elements). */
class OpaqueElement extends Shape {
    String kind
    /* Serialized XML of the source element for lossless save. */
    String xml
}

